{
  "brand": {
    "name": "Dfns - Rubik Design System",
    "version": "3.0",
    "source": "Figma — 🧊 Rubik 2026"
  },

  "fontFamilies": {
    "primary": {
      "name": "Suisse Intl",
      "type": "sans-serif",
      "source": "Swiss Typefaces",
      "format": "woff2",
      "webFiles": "web files/",
      "weights": {
        "light": 300,
        "regular": 400,
        "medium": 500,
        "semibold": 600
      },
      "italics": true,
      "usage": "All text (headings, body, UI)"
    },
    "monospace": {
      "name": "Roboto Mono",
      "type": "monospace",
      "source": "Google Fonts",
      "usage": "Code blocks, inline code, data"
    }
  },

  "rubikScale": {
    "note": "All styles: line-height AUTO, letter-spacing 0%. Available in 4 weights: Light, Base (Regular), Medium, Semibold.",
    "sizes": {
      "extraSmall": { "px": 10, "figmaSuffix": "/Extra Small" },
      "small": { "px": 12, "figmaSuffix": "/Small" },
      "base": { "px": 14, "figmaSuffix": "/Base" },
      "medium": { "px": 16, "figmaSuffix": "/Medium" },
      "large": { "px": 20, "figmaSuffix": "/Large" },
      "extraLarge": { "px": 24, "figmaSuffix": "/Extra Large" },
      "xExtraLarge": { "px": 28, "figmaSuffix": "/X Extra Large" },
      "titleH2": { "px": 36, "figmaSuffix": "/Title H2" },
      "titleH1": { "px": 48, "figmaSuffix": "/Title H1" }
    }
  },

  "textStyles": {
    "title": {
      "note": "H1 and H2 are always dual-tone. Use .h1-dual / .h2-dual with <span class='light'> (1st line) and <span class='emphasis'> (2nd line).",

      "h1": {
        "fontFamily": "Suisse Intl",
        "dualTone": true,
        "fontSize": "48px",
        "lineHeight": "auto",
        "letterSpacing": "0",
        "light": {
          "fontWeight": 300,
          "name": "Light",
          "colorDark": "#C4AEFF",
          "colorLight": "#442599",
          "role": "1st line — Ultra Purple accent (200 dark / 700 light)"
        },
        "emphasis": {
          "fontWeight": 400,
          "name": "Regular",
          "colorDark": "#E0E3F0",
          "colorLight": "#363A5B",
          "role": "2nd line — Cold Grey (100 dark / 700 light)"
        },
        "usage": "Page hero, landing headline. Always dual-tone."
      },

      "h2": {
        "fontFamily": "Suisse Intl",
        "dualTone": true,
        "fontSize": "36px",
        "lineHeight": "auto",
        "letterSpacing": "0",
        "light": {
          "fontWeight": 300,
          "name": "Light",
          "colorDark": "#C4AEFF",
          "colorLight": "#442599",
          "role": "1st line — Ultra Purple accent (200 dark / 700 light)"
        },
        "emphasis": {
          "fontWeight": 400,
          "name": "Regular",
          "colorDark": "#E0E3F0",
          "colorLight": "#363A5B",
          "role": "2nd line — Cold Grey"
        },
        "usage": "Section titles, feature headings. Always dual-tone."
      },

      "h3": {
        "fontFamily": "Suisse Intl",
        "fontWeight": 300,
        "fontSize": "32px",
        "lineHeight": "auto",
        "letterSpacing": "0",
        "color": "Cold Grey 700 (#363A5B)",
        "unified": true,
        "appliedVia": ".h3 class (decoupled from the <h3> element — Bootstrap-style)",
        "note": "2026-06-05: H3 is a single unified style — 32px / Light 300 / Cold Grey 700 — applied via the .h3 class, NOT by styling the bare <h3> element. Heading level is chosen for semantics/SEO; .h3 for appearance. The legal/terms/privacy page titles are <h1 class='legal-title h3'>. Card titles keep their own smaller sizes.",
        "usage": "Section / page titles. Defined in tokens.css as .h3"
      },

      "h4": {
        "fontFamily": "Suisse Intl",
        "fontWeight": 300,
        "fontSize": "20px",
        "lineHeight": "auto",
        "letterSpacing": "0",
        "note": "2026-06-05: aligned to the site (card/widget headers ~20px, e.g. blog card title).",
        "usage": "Widget titles, sidebar headers, card headers"
      },

      "h5": {
        "fontFamily": "Suisse Intl",
        "fontWeight": 300,
        "fontSize": "16px",
        "lineHeight": "auto",
        "letterSpacing": "0",
        "usage": "Table headers, panel headings, compact section labels"
      }
    },

    "body": {
      "xl": {
        "regular": {
          "fontFamily": "Suisse Intl",
          "fontWeight": 400,
          "fontSize": "22px",
          "lineHeight": "auto",
          "note": "2026-06-05: aligned to the site (hero lead = 22px).",
          "usage": "Introduction, lead paragraph"
        }
      },
      "l": {
        "regular": {
          "fontFamily": "Suisse Intl",
          "fontWeight": 400,
          "fontSize": "18px",
          "lineHeight": "auto",
          "note": "2026-06-05: aligned to the site (section subtitles = 18px).",
          "usage": "Main paragraphs, section subtitles"
        },
        "bold": {
          "fontFamily": "Suisse Intl",
          "fontWeight": 500,
          "fontSize": "20px",
          "lineHeight": "auto",
          "rubikStyle": "Medium/Large",
          "usage": "Important emphasis"
        }
      },
      "m": {
        "regular": {
          "fontFamily": "Suisse Intl",
          "fontWeight": 400,
          "fontSize": "16px",
          "lineHeight": "auto",
          "rubikStyle": "Base/Medium",
          "usage": "Default UI text"
        },
        "bold": {
          "fontFamily": "Suisse Intl",
          "fontWeight": 500,
          "fontSize": "16px",
          "lineHeight": "auto",
          "rubikStyle": "Medium/Medium",
          "usage": "Emphasis in body"
        }
      },
      "s": {
        "regular": {
          "fontFamily": "Suisse Intl",
          "fontWeight": 400,
          "fontSize": "14px",
          "lineHeight": "auto",
          "rubikStyle": "Base/Base",
          "usage": "Secondary text, descriptions"
        }
      },
      "xs": {
        "regular": {
          "fontFamily": "Suisse Intl",
          "fontWeight": 400,
          "fontSize": "12px",
          "lineHeight": "auto",
          "rubikStyle": "Base/Small",
          "usage": "Captions, footnotes"
        }
      },
      "xxs": {
        "regular": {
          "fontFamily": "Suisse Intl",
          "fontWeight": 400,
          "fontSize": "10px",
          "lineHeight": "auto",
          "rubikStyle": "Base/Extra Small",
          "usage": "Micro captions"
        }
      }
    },

    "ui": {
      "button": {
        "fontFamily": "Suisse Intl",
        "fontWeight": 500,
        "fontSize": "14px",
        "lineHeight": "auto",
        "textTransform": "none",
        "case": "sentence-case",
        "rubikStyle": "Medium/Base",
        "note": "2026-06-05: corrected to follow the site CTA system (500 Medium, sentence-case). The 600 Semibold UPPERCASE style is the Label / overline (see 'label'), NOT the button.",
        "usage": "Buttons, CTAs (Primary / Secondary / Tertiary)"
      },
      "label": {
        "fontFamily": "Suisse Intl",
        "fontWeight": 600,
        "fontSize": "14px",
        "lineHeight": "auto",
        "textTransform": "uppercase",
        "rubikStyle": "Semibold/Base",
        "usage": "Form labels, tags"
      }
    },

    "code": {
      "block": {
        "fontFamily": "Roboto Mono",
        "fontWeight": 400,
        "fontSize": "14px",
        "lineHeight": "auto",
        "rubikStyle": "Mono/Monospace Base",
        "usage": "Code blocks"
      },
      "inline": {
        "fontFamily": "Roboto Mono",
        "fontWeight": 400,
        "fontSize": "14px",
        "lineHeight": "auto",
        "rubikStyle": "Mono/Monospace Base",
        "usage": "Inline code"
      }
    },

    "data": {
      "statXL": { "fontFamily": "Suisse Intl", "fontWeight": 500, "fontSize": "48px", "rubikStyle": "Medium/Title H1", "usage": "Hero KPI" },
      "statL": { "fontFamily": "Suisse Intl", "fontWeight": 500, "fontSize": "36px", "rubikStyle": "Medium/Title H2", "usage": "Secondary KPI" },
      "statM": { "fontFamily": "Suisse Intl", "fontWeight": 500, "fontSize": "28px", "rubikStyle": "Medium/X Extra Large", "usage": "Compact stats" },
      "data": { "fontFamily": "Suisse Intl", "fontWeight": 400, "fontSize": "14px", "rubikStyle": "Base/Base", "usage": "Wallet addresses, amounts, timestamps" }
    }
  }
}
