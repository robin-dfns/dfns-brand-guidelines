{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/crypto-icons-round/**",
              "assets/crypto-icons-square/**",
              "assets/icons/**",
              "components/buttons/**",
              "components/content/**",
              "components/feedback/**",
              "components/forms/**",
              "components/marketing/**",
              "components/navigation/**",
              "ui_kits/dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:SuisseIntl|RobotoMono|PPNeueMontreal|Suisse Intl|Roboto Mono|PP Neue Montreal|Suisse Intl Trial))/i]",
        "message": "Font not provided by the design system. Available: SuisseIntl, RobotoMono, PPNeueMontreal, Suisse Intl, Roboto Mono, PP Neue Montreal, Suisse Intl Trial."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: color, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:default|blue|green|red|yellow|grey)$/]",
        "message": "<Badge> color must be one of 'default' | 'blue' | 'green' | 'red' | 'yellow' | 'grey'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|disabled|iconLeft|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, disabled, iconLeft, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|key|ref|className|style|children)$/]",
        "message": "<CardHeader> doesn't accept that prop. Declared props: title, description."
      },
      {
        "selector": "JSXOpeningElement[name.name='CryptoIconRound'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<CryptoIconRound> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='CryptoIconSquare'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<CryptoIconSquare> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='CryptoIconsRound'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<CryptoIconsRound> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='CryptoIconsSquare'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<CryptoIconsSquare> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTAPrimary'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|showIcon|key|ref|className|style|children)$/]",
        "message": "<CTAPrimary> doesn't accept that prop. Declared props: children, showIcon."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTAPrimaryV1'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|showIcon|key|ref|className|style|children)$/]",
        "message": "<CTAPrimaryV1> doesn't accept that prop. Declared props: children, showIcon."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTASecondaryTestV1'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|showIcon|key|ref|className|style|children)$/]",
        "message": "<CTASecondaryTestV1> doesn't accept that prop. Declared props: children, showIcon."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTATertiary'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|key|ref|className|style|children)$/]",
        "message": "<CTATertiary> doesn't accept that prop. Declared props: children, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='DfnsLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|withWordmark|base|key|ref|className|style|children)$/]",
        "message": "<DfnsLogo> doesn't accept that prop. Declared props: height, withWordmark, base."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconInfoWithTooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|showing|size|key|ref|className|style|children)$/]",
        "message": "<IconInfoWithTooltip> doesn't accept that prop. Declared props: text, showing, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconInfoWithTooltip'] > JSXAttribute[name.name='showing'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<IconInfoWithTooltip> showing must be one of 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoTooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|showing|size|key|ref|className|style|children)$/]",
        "message": "<InfoTooltip> doesn't accept that prop. Declared props: text, showing, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoTooltip'] > JSXAttribute[name.name='showing'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<InfoTooltip> showing must be one of 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|onChange|iconLeft|iconRight|action|disabled|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, placeholder, value, onChange, iconLeft, iconRight, action, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logotype'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|base|key|ref|className|style|children)$/]",
        "message": "<Logotype> doesn't accept that prop. Declared props: variant, height, base."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logotype'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:full|symbol)$/]",
        "message": "<Logotype> variant must be one of 'full' | 'symbol'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MobileMenu'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onSelect|key|ref|className|style|children)$/]",
        "message": "<MobileMenu> doesn't accept that prop. Declared props: items, active, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|width|height|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, width, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectorBig'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|onClick|key|ref|className|style|children)$/]",
        "message": "<SelectorBig> doesn't accept that prop. Declared props: icon, label, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slot'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|width|height|children|key|ref|className|style|children)$/]",
        "message": "<Slot> doesn't accept that prop. Declared props: label, width, height, children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
