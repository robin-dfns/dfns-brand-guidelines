        "selector": "JSXOpeningElement[name.name='SelectorBig'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|avatar|avatarColor|trailingIcon|style|key|ref|className|style|children)$/]",
        "message": "<SelectorBig> doesn't accept that prop. Declared props: label, avatar, avatarColor, trailingIcon, style."
