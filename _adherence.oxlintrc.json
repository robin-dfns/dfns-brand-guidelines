      {
        "selector": "JSXOpeningElement[name.name='Slot'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|style|key|ref|className|style|children)$/]",
        "message": "<Slot> doesn't accept that prop. Declared props: label, children, style."
      }
    ]
  },
