{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/crypto/**",
              "assets/icons/**",
              "components/actions/**",
              "components/brand/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/glyphs/**",
              "components/navigation/**",
              "ui_kits/dashboard/**",
              "ui_kits/mobile/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Suisse Intl|Suisse Intl Trial))/i]",
        "message": "Font not provided by the design system. Available: Suisse Intl, Suisse Intl Trial."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: color, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:default|grey|green|yellow|red|blue)$/]",
        "message": "<Badge> color must be one of 'default' | 'grey' | 'green' | 'yellow' | 'red' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|state|disabled|leadingIcon|trailingIcon|fullWidth|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, state, disabled, leadingIcon, trailingIcon, fullWidth, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|secondary|outline|ghost|destructive)$/]",
        "message": "<Button> variant must be one of 'default' | 'secondary' | 'outline' | 'ghost' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|default|lg|icon)$/]",
        "message": "<Button> size must be one of 'sm' | 'default' | 'lg' | 'icon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:rest|hover|disabled)$/]",
        "message": "<Button> state must be one of 'rest' | 'hover' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonLegacy'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|variant|leadingIcon|trailingIcon|children|style|key|ref|className|style|children)$/]",
        "message": "<ButtonLegacy> doesn't accept that prop. Declared props: tone, variant, leadingIcon, trailingIcon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonLegacy'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|secondary|outline|ghost)$/]",
        "message": "<ButtonLegacy> tone must be one of 'primary' | 'secondary' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonLegacy'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:Default|Hover|Disabled)$/]",
        "message": "<ButtonLegacy> variant must be one of 'Default' | 'Hover' | 'Disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|trailing|style|key|ref|className|style|children)$/]",
        "message": "<CardHeader> doesn't accept that prop. Declared props: title, description, trailing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CryptoIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|shape|size|key|ref|className|style|children)$/]",
        "message": "<CryptoIcon> doesn't accept that prop. Declared props: symbol, shape, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='CryptoIcon'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:round|square)$/]",
        "message": "<CryptoIcon> shape must be one of 'round' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CryptoIconRound'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|size|style|key|ref|className|style|children)$/]",
        "message": "<CryptoIconRound> doesn't accept that prop. Declared props: symbol, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CryptoIconSquare'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|size|style|key|ref|className|style|children)$/]",
        "message": "<CryptoIconSquare> doesn't accept that prop. Declared props: symbol, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CryptoIconsRoundCryptocurrencies'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|size|style|key|ref|className|style|children)$/]",
        "message": "<CryptoIconsRoundCryptocurrencies> doesn't accept that prop. Declared props: symbol, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CryptoIconsSquareNetworks'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|size|style|key|ref|className|style|children)$/]",
        "message": "<CryptoIconsSquareNetworks> doesn't accept that prop. Declared props: symbol, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTAPrimary'] > JSXAttribute > JSXIdentifier[name!=/^(?:hover|children|style|key|ref|className|style|children)$/]",
        "message": "<CTAPrimary> doesn't accept that prop. Declared props: hover, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTASecondary'] > JSXAttribute > JSXIdentifier[name!=/^(?:hover|children|style|key|ref|className|style|children)$/]",
        "message": "<CTASecondary> doesn't accept that prop. Declared props: hover, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTATertiary'] > JSXAttribute > JSXIdentifier[name!=/^(?:hover|children|style|key|ref|className|style|children)$/]",
        "message": "<CTATertiary> doesn't accept that prop. Declared props: hover, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DFNSLogoColoredLight'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|showType|color|style|key|ref|className|style|children)$/]",
        "message": "<DFNSLogoColoredLight> doesn't accept that prop. Declared props: height, showType, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconCircle'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|style|key|ref|className|style|children)$/]",
        "message": "<IconCircle> doesn't accept that prop. Declared props: size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconCopy'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|style|key|ref|className|style|children)$/]",
        "message": "<IconCopy> doesn't accept that prop. Declared props: size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|style|key|ref|className|style|children)$/]",
        "message": "<IconDot> doesn't accept that prop. Declared props: size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconInfoTooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:showing|open|content|size|style|key|ref|className|style|children)$/]",
        "message": "<IconInfoTooltip> doesn't accept that prop. Declared props: showing, open, content, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconInfoTooltip'] > JSXAttribute[name.name='showing'] > Literal[value!=/^(?:Top|Bottom)$/]",
        "message": "<IconInfoTooltip> showing must be one of 'Top' | 'Bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconLoaderCircle'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|style|key|ref|className|style|children)$/]",
        "message": "<IconLoaderCircle> doesn't accept that prop. Declared props: size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|required|hint|leadingIcon|trailingIcon|placeholder|invalid|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, required, hint, leadingIcon, trailingIcon, placeholder, invalid, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logotype'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|showType|color|style|key|ref|className|style|children)$/]",
        "message": "<Logotype> doesn't accept that prop. Declared props: height, showType, color, style."
