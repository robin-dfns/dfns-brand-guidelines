      {
        "selector": "JSXOpeningElement[name.name='MobileMenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|key|ref|className|style|children)$/]",
        "message": "<MobileMenuItem> doesn't accept that prop. Declared props: label, icon."
